# Copy to .env (never commit .env!), fill or generate real values.
# Automated: ./scripts/provision_decentralized.sh  (generates all secrets).
# After manual edit: chmod 600 .env
# This is the template of the decentralized (file-based) secret storage.

APP_SECRETS_SOURCE=file

# --- required secrets ---
APP_SECRET_KEY=change-me-openssl-rand-hex-32
DATABASE_URL=postgresql://app_user:change-me@db.internal:5432/appdb
EXTERNAL_API_TOKEN=change-me-openssl-rand-hex-24

# --- optional secrets ---
JWT_SECRET=
SMTP_HOST=smtp.example.org
SMTP_USER=service@example.org
SMTP_PASSWORD=

# --- only needed for APP_SECRETS_SOURCE=vault (centralized mode) ---
#VAULT_ADDR=http://127.0.0.1:8200
#VAULT_TOKEN=
#VAULT_APPROLE_ROLE_ID=
#VAULT_APPROLE_SECRET_ID=
#VAULT_MOUNT=secret
#VAULT_SECRET_PATH=lab10
